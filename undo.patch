+    final p = byId(id);
+    if (p == null || p.tracks.any((x) => x.id == t.id)) return;
+    await _update(id, (p) {
+      final list = [...p.tracks];
+      list.insert(index.clamp(0, list.length), t);
+      return _copy(p, tracks: list);
+    });
+  }
